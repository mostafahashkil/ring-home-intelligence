{
  "name": "ring-home-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Ring Home Intelligence — a concept companion app that turns supported camera events into calm, household-aware notifications. Not an official Amazon Ring product.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset-demo": "tsx scripts/reset-demo.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@netlify/database": "^2.0.1",
    "better-sqlite3": "^12.4.1",
    "lucide-react": "^0.544.0",
    "next": "^16.3.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.3.8",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
