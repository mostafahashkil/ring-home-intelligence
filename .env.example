# Ring Home Intelligence — environment variables
# Copy to .env.local and fill in. Placeholder names only — never commit real values.

# --- App security -----------------------------------------------------------
# 32-byte key, base64 encoded. Encrypts Ring tokens at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production. In development a local key file is generated in ./data if unset.
APP_ENCRYPTION_KEY=

# Public base URL of this app (used for OAuth redirect URIs). HTTPS in production.
APP_BASE_URL=http://localhost:3000

# SQLite database file for local development (default: ./data/rhi.db)
DATABASE_PATH=

# Postgres connection string. Netlify sets this automatically when Netlify Database is provisioned;
# when present the app uses Postgres instead of SQLite. Leave unset locally.
# NETLIFY_DB_URL=

# --- Ring Partner API (optional — app runs in demo mode without these) -------
# Issued during Ring AppStore partner onboarding (developer.amazon.com/ring).
RING_CLIENT_ID=
RING_CLIENT_SECRET=
# HMAC signing key — used to verify webhook X-Signature headers.
RING_HMAC_SIGNING_KEY=

# Partner-initiated OAuth 2.0 (PKCE) — invitation-only per Ring docs.
# Must exactly match a redirect URI registered in the Ring Developer Portal.
RING_OAUTH_REDIRECT_URI=
# Scope approved for your app (docs: "Only the scope ava.v1:read is supported currently").
RING_OAUTH_SCOPE=ava.v1:read

# Development shortcut (same approach as Ring's ring-api-helloworld sample):
# set ONE of these to connect without running the OAuth flow.
# RING_ACCESS_TOKEN — short-lived token from the Ring Developer Playground.
# RING_REFRESH_TOKEN — requires RING_CLIENT_ID / RING_CLIENT_SECRET; rotated tokens are stored encrypted.
RING_ACCESS_TOKEN=
RING_REFRESH_TOKEN=
